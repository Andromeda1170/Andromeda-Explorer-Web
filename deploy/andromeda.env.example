# /etc/andromeda/andromeda.env — wird von allen Andromeda-Diensten gelesen.
# Hier stehen KEINE Geheimnisse (die liegen in /etc/andromeda/admin.json).
# Alles ist optional; ohne Eintrag gelten die Standardwerte.

# Adresse der Website (CORS, Links in Tourseiten, Sitemap)
#ANDROMEDA_ORIGIN=https://andromeda-explorer.com

# Kontakt im User-Agent für Nominatim/Overpass (deren Nutzungsregeln verlangen das)
#ANDROMEDA_CONTACT=support.andromeda-explorer@protonmail.com

# Datenordner und Konfigurationsordner
#ANDROMEDA_DATA=/var/lib/andromeda
#ANDROMEDA_CONFIG_DIR=/etc/andromeda

# Hinter Caddy: echte Client-IP aus X-Forwarded-For (1) oder nicht (0)
#ANDROMEDA_TRUST_PROXY=1

# Anzahl gleichzeitiger BRouter-Berechnungen. Muss zur Thread-Zahl in
# brouter.service passen (dort vorletzte Zahl in ExecStart, Standard 3).
#ANDROMEDA_BROUTER_THREADS=3
